rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teacher/student profile documents — only the owner can read or write their own.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /examRooms/{roomCode} {
      // Public metadata + question text/options (NEVER correctAnswer — that field is
      // never stored here) — readable by anyone so students can load the exam without
      // logging in.
      allow read: if true;

      // Only a logged-in teacher can create a room, and only as themselves.
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";

      // Only the owning teacher can update it (e.g. closing the room).
      allow update: if request.auth != null
        && resource.data.teacherId == request.auth.uid;

      // The answer key never leaves the server to anyone except the owning teacher's
      // own review screen. The grading function (api/grade-exam.js) uses the Admin
      // SDK, which bypasses these rules entirely — it doesn't need a rule here.
      match /secure/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/examRooms/$(roomCode)).data.teacherId;
      }
    }

    match /candidates/{candidateId} {
      // Public read so the teacher's live leaderboard works without students logging in.
      allow read: if true;

      // A student must be logged in, and can only ever write a record under their OWN
      // authenticated email — nobody can submit an exam attempt pretending to be
      // someone else. Clients may only ever write an "in-progress" heartbeat; final
      // "completed" / "disqualified" results (and the score with them) are written
      // exclusively by api/grade-exam.js via the Admin SDK, which bypasses these rules —
      // so a student can never fabricate a passing score by writing directly.
      allow create: if request.auth != null
        && request.resource.data.status == "in-progress"
        && request.resource.data.studentEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.status == "in-progress"
        && request.resource.data.status == "in-progress"
        && resource.data.studentEmail == request.auth.token.email;
    }

    // Lesson plans, assignments, quizzes-as-drafted, and grading reports a teacher has
    // generated. Only the owning teacher can ever read, create, or delete their own —
    // this is what stops two different teacher accounts from seeing each other's content.
    match /generatedContent/{docId} {
      allow read: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }
  }
}